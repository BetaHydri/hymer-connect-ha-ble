  "switches": {    "_doc": "Universal switches on bus 3 (habitation electrics). write_type: how the PIA command is sent. on_value: readback value meaning ON. holdoff_off: seconds to hold optimistic OFF (for SCU bounce-back).",
    "3,1": {
      "name": "main_switch_ctrl",
      "icon": "mdi:power",
      "write_type": "str",
      "write_on": "On",
      "write_off": "Off",
      "on_value": "On",
      "read_path": "signalr_sensors.main_switch",
      "holdoff_off": 60,
      "requires_12v": false
    },
    "3,3": {
      "name": "water_pump_ctrl",
      "icon": "mdi:water-pump",
      "write_type": "bool",
      "on_value": true,
      "read_path": "signalr_sensors.water_pump_active",
      "requires_12v": true
    }
  },
  "climate": {
    "_doc": "Universal writable controls shared across all EHG brands. The Dometic compressor fridge (bus 60 = DometicCompressorFridge) is a fixed EHG component bound to bus 60 on every brand, so its controls live here and are observation-gated (require_observed) — the select entities are created only once the vehicle reports bus 60. On-vehicle confirmed via the HYMER-Group SCU (owner 'Jos').",
    "selects": {
      "fridge_dometic_cooling_step": {
        "_doc": "Dometic compressor fridge (bus 60 = DometicCompressorFridge) Off/1-5 cooling-step control. Ground truth from the decompiled EHG app (componentId 60): PowerOn = slot 8 (bool rw), Temperature = slot 2 (int rw, range 1-5, NO 0/Off). Mirrors the Thetford drivers (bus 34/32/114): power sid 8 (bool) then cooling-step sid 2 (uint). Off routes to PowerOn=false. Both the cooling-level write (slot 2) AND the on/off write (slot 8, Off branch) CONFIRMED on-vehicle by HYMER Dometic owner 'Jos' (2026-08-23). require_observed: created only when bus 60 is reported.",
        "name": "Dometic fridge cooling step",
        "icon": "mdi:fridge-industrial-outline",
        "control_bus": 60,
        "require_observed": true,
        "options": ["Off", "1", "2", "3", "4", "5"],
        "read": {
          "step_sensor": "dometic_fridge_level",
          "power_sensor": "dometic_fridge_power",
          "off_when_power_false": true,
          "off_value": 0
        },
        "writes": {
          "off": [{ "sid": 8, "bool": false }],
          "step": [
            { "sid": 8, "bool": true },
            { "delay_ms": 500 },
            { "sid": 2, "uint": "$option_int" }
          ]
        }
      },
      "fridge_dometic_mode": {
        "_doc": "Dometic compressor fridge user mode = the EHG app's 'Modus' selector (bus 60 slot 1 = UserMode, string rw per decompiled EHG app componentId 60, id 1). Options are the SCU wire values from the decompiled stringRange ('Performance Cooling'/'Silent Mode'/'Turbo Mode'); the app LOCALIZES these for display (DE: Normal/Leise/Turbo). Options MUST stay as the wire values for readback (sensor dometic_fridge_mode 60,1) and write to match — do NOT relabel. WRITE PATH on bus 60 slot 1 CONFIRMED on-vehicle by HYMER Dometic owner 'Jos' (2026-08-24). require_observed: created only when bus 60 is reported.",
        "name": "Dometic fridge mode",
        "icon": "mdi:fridge",
        "control_bus": 60,
        "require_observed": true,
        "options": ["Performance Cooling", "Silent Mode", "Turbo Mode"],
        "read": { "value_sensor": "dometic_fridge_mode" },
        "writes": { "option": [{ "sid": 1, "str": "$option" }] }
      }
    }
  }
}
