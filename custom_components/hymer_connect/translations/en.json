{
  "config": {
    "step": {
      "user": {
        "title": "HYMER Connect Login",
        "description": "Enter your HYMER Connect account credentials. Use the same email and password as in the HYMER Connect app.",
        "data": {
          "brand": "Brand",
          "username": "Email",
          "password": "Password",
          "ehg_refresh_token": "EHG Remote Access Refresh Token (optional)",
          "oauth_basic_auth": "OAuth client header (optional)"
        },
        "data_description": {
          "ehg_refresh_token": "Required for real-time sensor data via SignalR. This is a long-lived token obtained during BLE pairing. Capture it via mitmproxy — see the README for instructions.",
          "oauth_basic_auth": "The full 'Authorization: Basic …' header used on OAuth /token requests. Captured from your own EHG app traffic via mitmproxy (the capture tool saves it alongside the refresh token). Leave empty to use the bundled legacy default (deprecated; will be removed in a future release)."
        }
      },
      "vehicle": {
        "title": "Vehicle Activation",
        "description": "Recommended: enter the QR code and SCU Bluetooth address to enable BLE pairing. The integration will obtain the EHG refresh token automatically during the first connection — no mitmproxy needed.\n\n⚠️ Order matters: press the CONNECTION button on the SCU control panel FIRST, then submit this form within ~25 seconds. Some SCUs hold the pairing window open for only ~30 seconds. This is the same button you pressed when pairing the EHG app.\n\nIf you don't have BLE hardware, leave both fields empty and provide the EHG refresh token from Step 1 instead.",
        "data": {
          "qr_activation_token": "QR code activation token",
          "ble_scu_address": "SCU Bluetooth address",
          "ble_enabled": "Enable BLE direct path"
        },
        "data_description": {
          "qr_activation_token": "The text encoded in the QR activation code provided by your dealer (on the vehicle handover papers, NOT a sticker on the vehicle/SCU). Scan it with any QR reader app and paste the text here.",
          "ble_scu_address": "Bluetooth MAC address of the SCU (e.g. AA:BB:CC:DD:EE:FF). Leave empty to auto-scan.",
          "ble_enabled": "Enable the BLE direct path for ongoing communication with the SCU (lower latency, works without cloud). Disable if you only want to use BLE for the initial token pairing but prefer cloud (SignalR) for daily use."
        }
      },
      "reauth_confirm": {
        "title": "[%key:common::config_flow::title::reauth%]",
        "description": "The HYMER Connect integration needs to re-authenticate your account.",
        "data": {
          "username": "Email",
          "password": "Password"
        }
      },
      "reconfigure": {
        "title": "Reconfigure HYMER Connect",
        "description": "Add or update the QR code activation token, SCU Bluetooth address, EHG refresh token, or OAuth client header. Leave a field empty to keep the current value.\n\nTo re-pair over BLE (e.g. after moving Home Assistant to a new host): tick 'Re-pair over BLE', leave the QR token in place, press CONNECTION on the SCU FIRST and submit within ~25 seconds. The pre-filled EHG token is then ignored and a fresh one is minted on success (the old token stays intact if pairing fails).",
        "data": {
          "qr_activation_token": "QR code activation token",
          "ble_scu_address": "SCU Bluetooth address",
          "ehg_refresh_token": "EHG Remote Access Refresh Token",
          "oauth_basic_auth": "OAuth client header",
          "force_repair": "Re-pair over BLE (mint a new EHG token)"
        },
        "data_description": {
          "qr_activation_token": "Paste the text from the dealer-provided QR activation code (on the vehicle handover document) to link the vehicle and enable BLE pairing.",
          "ble_scu_address": "Bluetooth MAC address of the SCU (e.g. AA:BB:CC:DD:EE:FF) to enable the BLE direct path.",
          "ehg_refresh_token": "The long-lived remote-access refresh token. If you already have one from mitmproxy, paste it here.",
          "oauth_basic_auth": "The full 'Authorization: Basic …' header used on OAuth /token requests. Captured from your own EHG app traffic via mitmproxy. Leave empty to keep the current value (or to fall back to the deprecated bundled default if none was set).",
          "force_repair": "Tick this to force a fresh BLE bond and mint a new EHG token, even though the token field is pre-filled. Requires a QR activation token (entered here or already stored). Use this after moving HA to a new host, where the OS-level Bluetooth bond was lost. Press CONNECTION on the SCU first, then submit within ~25 seconds."
        }
      },
      "ble_pairing": {
        "title": "BLE Pairing with SCU",
        "description": "If you haven't already, press the **CONNECTION** (connection) button on the SCU control panel in your vehicle now.\n\nThe integration is connecting via Bluetooth and waiting for the SCU to accept the pairing request. It retries for up to 2 minutes, but some SCUs hold the pairing window open only ~30 seconds — so press CONNECTION right as you submit.\n\nDo NOT close this dialog."
      },
      "ble_result": {
        "title": "BLE Pairing Complete",
        "description": "BLE pairing was successful! The EHG refresh token has been obtained and stored. The integration will use this token for real-time sensor data via SignalR."
      }
    },
    "progress": {
      "ble_pairing": "Waiting for SCU to accept BLE pairing... Press CONNECTION on the vehicle control panel now. Retrying for up to 2 minutes."
    },
    "error": {
      "cannot_connect": "Failed to connect to HYMER Connect API",
      "invalid_auth": "Invalid email or password",
      "invalid_basic_auth": "OAuth client header is malformed. Expected 'Basic base64(client_id:secret)'.",
      "invalid_qr_token": "Invalid QR activation token — could not resolve vehicle",
      "qr_token_required": "QR activation token is required",
      "no_changes": "No changes provided — enter at least one field",
      "ble_no_scu_found": "No SCU found via Bluetooth scan — make sure you are near the vehicle",
      "ble_no_confirmation_token": "Could not obtain confirmation token from cloud API",
      "ble_no_refresh_token": "BLE pairing completed but SCU did not return a refresh token",
      "ble_pairing_failed": "BLE pairing failed — make sure you pressed CONNECTION on the SCU and are near the vehicle",
      "unknown": "Unexpected error occurred"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
    }
  },
