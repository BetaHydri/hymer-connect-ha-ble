        "data_description": {
          "tank_capacity_liters": "Size of the diesel tank in liters. Common values: 71 L (Sprinter 314/316 CDI), 93 L (Sprinter 419/519 CDI standard). Used to compute fuel level in liters, consumption (L/100km), and estimated range.",
          "ble_enabled": "Subscribe to sensor pushes directly from the SCU over Bluetooth Low Energy. Three benefits the cloud can't give: (1) faster updates (~50 ms vs 0.5–2 s over cloud); (2) live sensors with no internet/LTE (fully offline after the one-time setup); (3) live sensors even while 12V is OFF — in standby the cloud stops pushing doors/temps/water/battery, but the SCU's BLE stays active. Commands still go via the cloud by default; enable the separate 'Send commands over BLE' option below to also try writes locally. Requires BLE hardware (e.g. Raspberry Pi 4 built-in) and one-time physical pairing at the vehicle.",
          "ble_scu_address": "The Bluetooth MAC address of the SCU (e.g. XX:XX:XX:XX:XX:XX). Leave empty to auto-scan for nearby SCU devices on startup.",
          "ble_write_enabled": "Route commands (lights, switches, heater, etc.) over the local BLE link first when BLE is connected — faster and works without internet — falling back to the cloud automatically if the SCU does not acknowledge. On by default; if BLE is not connected everything goes via the cloud anyway. Untick to force cloud-only. Confirmed working on the Grand Canyon S (SCU fw 1.12); on other models the automatic cloud fallback keeps commands working.",
          "clear_ble_bond": "Remove the stored BLE bond and EHG refresh token. Use this after deleting the HA pairing from the EHG app's Bluetooth settings. After clearing, use Reconfigure to re-pair with the SCU.",
          "ehg_refresh_token": "The long-lived token obtained during BLE pairing. Required for real-time sensor data via SignalR. Capture it via mitmproxy — see the README for instructions. Leave empty to disable SignalR.",
          "oauth_basic_auth": "The full 'Authorization: Basic …' header used on OAuth /token requests. Captured from your own EHG app traffic via mitmproxy. Leave empty to use the bundled legacy default (deprecated)."
        }
      }
